# ChoiceGuard environment variables
# Copy this file to `.env` and fill in what you need, then `npm run build`.
# Both variables are optional — the extension works fully without either:
#   - No OpenAI key -> AI explanations fall back to built-in template text.
#   - No Firebase project -> the dashboard falls back to bundled mock data.

# --- OpenAI (optional developer-convenience default) ---------------------
# Baked into the extension bundle at build time as a fallback default key.
# End users can also paste their own key in the popup's Settings tab —
# that value is stored in chrome.storage.local and always takes priority.
VITE_OPENAI_API_KEY=

# --- Firebase / Firestore demo backend (optional) -------------------------
# Just the project ID — ChoiceGuard talks to the Firestore REST API
# directly, no firebase-js-sdk, no service account, no API key required.
# See README.md "Firebase setup" for how to create the project + rules.
VITE_FIREBASE_PROJECT_ID=
